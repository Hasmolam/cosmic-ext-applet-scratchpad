[Desktop Entry]
Name=Scratchpad
Comment=Minimalist quick notes and code scratchpad for COSMIC
Exec=cosmic-ext-applet-scratchpad
Icon=io.github.hasmolam.cosmic-ext-applet-scratchpad-symbolic
Terminal=false
Type=Application
Categories=COSMIC;
Keywords=COSMIC;Applet;Scratchpad;Notes;
StartupNotify=true
X-CosmicApplet=true
X-CosmicHoverPopup=Auto
X-CosmicShrinkable=true
X-OverflowPriority=10
NoDisplay=true
