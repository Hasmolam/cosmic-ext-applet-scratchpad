# Maintainer: Hasan Hüseyin Yolcu <hasanhuseyinyolcu25@gmail.com>
pkgname=cosmic-ext-applet-scratchpad-git
pkgver=0.1.0
pkgrel=1
pkgdesc="Minimalist quick notes and scratchpad applet for the COSMIC Desktop"
arch=('x86_64' 'aarch64')
url="https://github.com/Hasmolam/cosmic-ext-applet-scratchpad"
license=('GPL-3.0-only')
depends=('libxkbcommon' 'wayland' 'hicolor-icon-theme')
makedepends=('cargo' 'just' 'git')
provides=('cosmic-ext-applet-scratchpad')
conflicts=('cosmic-ext-applet-scratchpad')
source=("git+https://github.com/Hasmolam/cosmic-ext-applet-scratchpad.git")
sha256sums=('SKIP')

pkgver() {
    cd "${srcdir}/${pkgname%-git}"
    git describe --long --tags --always 2>/dev/null | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g' ||
    printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

build() {
    cd "${srcdir}/${pkgname%-git}"
    just build
}

package() {
    cd "${srcdir}/${pkgname%-git}"
    just rootdir="${pkgdir}" prefix="/usr" install
}
